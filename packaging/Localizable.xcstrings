{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "\n点击后清除筛选并定位此活动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nClick to clear filters and locate this activity"
          }
        }
      }
    },
    " · 计入投入时长": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · Counts toward productive time"
          }
        }
      }
    },
